@page
@model EduLearn.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-card">
    <div class="text-center mb-4">
        <svg class="icon" style="width:2.5rem;height:2.5rem;color:var(--color-primary);" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
        <h2 class="section-title mt-2 mb-1">Forgot your password?</h2>
        <p class="text-muted-2">Enter your email and we'll send you a reset link.</p>
    </div>

    <div class="card form-card">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <form method="post">
            <div class="mb-4">
                <label class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
        </form>
    </div>

    <p class="text-center text-muted-2 mt-3 mb-0">
        Remembered it? <a asp-page="/Account/Login">Back to Login</a>
    </p>
</div>
