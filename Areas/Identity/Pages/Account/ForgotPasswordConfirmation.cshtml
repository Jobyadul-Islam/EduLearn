@page
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="empty-state mx-auto" style="max-width:480px;">
    <svg class="icon" viewBox="0 0 24 24"><path d="M22 6c0-1.1-.9-2-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h16a2 2 0 0 0 2-2V6Z"/><path d="m22 6-10 7L2 6"/></svg>
    <h2 class="section-title mb-2">Check Your Email</h2>
    <p>If an account with that email exists, we've sent a password reset link to it.</p>
    <a asp-page="/Account/Login" class="btn btn-primary">Back to Login</a>
</div>
