@page
@model EduLearn.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-card">
    <div class="text-center mb-4">
        <h2 class="section-title mt-2 mb-1">Reset your password</h2>
        <p class="text-muted-2">Choose a new password for your account.</p>
    </div>

    <div class="card form-card">
        @if (Model.LinkExpired)
        {
            <div class="alert alert-danger">
                <p class="mb-2">This reset link is invalid or has expired — it may have already been used, or the link is older than your current account.</p>
                <a asp-page="/Account/ForgotPassword" class="btn btn-primary btn-sm">Request a new reset link</a>
            </div>
        }
        else
        {
            <div asp-validation-summary="All" class="text-danger mb-2"></div>
            <form method="post">
                <input type="hidden" asp-for="Input.Email" />
                <input type="hidden" asp-for="Input.Code" />
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">New Password</label>
                    <input asp-for="Input.Password" type="password" class="form-control" />
                </div>
                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm New Password</label>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Reset Password</button>
            </form>
        }
    </div>
</div>
