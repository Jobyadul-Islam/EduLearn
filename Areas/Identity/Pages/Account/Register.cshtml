@page
@model EduLearn.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-card">
    <div class="text-center mb-4">
        <svg class="icon" style="width:2.5rem;height:2.5rem;color:var(--color-primary);" viewBox="0 0 24 24"><path d="M22 10L12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg>
        <h2 class="section-title mt-2 mb-1">Create your account</h2>
        <p class="text-muted-2">Join EduLearn as a student.</p>
    </div>

    <div class="card form-card">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="Input.FullName" class="form-label">Full Name</label>
                <input asp-for="Input.FullName" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" />
            </div>
            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
            </div>
            <div class="mb-4" data-picture-cropper>
                <label asp-for="Input.ProfilePicture" class="form-label">Profile Picture</label>
                <input asp-for="Input.ProfilePicture" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" data-cropper-file-input />
                <span asp-validation-for="Input.ProfilePicture" class="text-danger"></span>
                <div class="d-none mt-3 text-center" data-cropper-stage>
                    <div data-cropper-viewport style="width:180px;height:180px;border-radius:50%;overflow:hidden;position:relative;margin:0 auto;cursor:grab;background:var(--color-bg);border:1px solid var(--color-border);touch-action:none;">
                        <img data-cropper-image style="position:absolute;max-width:none;user-select:none;" alt="" />
                    </div>
                    <label class="visually-hidden" for="registerZoomSlider">Zoom photo</label>
                    <input type="range" id="registerZoomSlider" data-cropper-zoom min="100" max="300" value="100" class="form-range mt-2 mx-auto d-block" style="max-width:180px;" />
                    <p class="text-muted-2 small mt-1 mb-0">Drag the photo to reposition it</p>
                </div>
                <span class="text-danger d-block small mt-1" data-cropper-error></span>
                <span asp-validation-for="Input.CroppedPictureData" class="text-danger d-block small"></span>
                <input asp-for="Input.CroppedPictureData" type="hidden" data-cropper-output />
            </div>
            <button type="submit" class="btn btn-primary w-100">Create Account</button>
        </form>
    </div>

    <p class="text-center text-muted-2 mt-3 mb-0">
        Already have an account? <a asp-page="/Account/Login">Login</a>
    </p>
    <p class="text-center text-muted-2 mt-2 mb-0">
        Want to teach on EduLearn? <a asp-controller="Apply" asp-action="Index" asp-area="">Apply as an instructor</a>
    </p>
</div>