@page
@model EduLearn.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-card">
    <div class="text-center mb-4">
        <svg class="icon" style="width:2.5rem;height:2.5rem;color:var(--color-primary);" viewBox="0 0 24 24"><path d="M22 10L12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg>
        <h2 class="section-title mt-2 mb-1">Create your account</h2>
        <p class="text-muted-2">Join EduLearn as a student or instructor.</p>
    </div>

    <div class="card form-card">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input asp-for="Input.FullName" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
            </div>
            <div class="mb-4">
                <label class="form-label">Register as</label>
                <select asp-for="Input.Role" class="form-select">
                    <option value="Student">Student</option>
                    <option value="Instructor">Instructor (requires Admin approval before publishing courses)</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary w-100">Create Account</button>
        </form>
    </div>

    <p class="text-center text-muted-2 mt-3 mb-0">
        Already have an account? <a asp-page="/Account/Login">Login</a>
    </p>
</div>
