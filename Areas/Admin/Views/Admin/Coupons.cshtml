@model List<EduLearn.Models.Coupon>

@{
    ViewData["Title"] = "Coupons";
}

<a asp-action="Index" class="text-decoration-none small text-muted-2">← Back to Dashboard</a>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 mt-2">
    <div>
        <h2 class="section-title mb-1">Coupons</h2>
        <p class="text-muted-2 mb-0">Percentage-off codes students can apply at cart checkout.</p>
    </div>
    <a asp-action="CreateCoupon" class="btn btn-primary">+ Create Coupon</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <p class="mb-0">No coupons yet. Create one to offer a discount at checkout.</p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Discount</th>
                    <th>Expires</th>
                    <th>Redemptions</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    bool expired = c.ExpiresAt.HasValue && c.ExpiresAt.Value < DateTime.Now;
                    bool exhausted = c.MaxRedemptions.HasValue && c.TimesRedeemed >= c.MaxRedemptions.Value;
                    <tr>
                        <td class="fw-semibold">@c.Code</td>
                        <td>@c.DiscountPercent%</td>
                        <td>@(c.ExpiresAt.HasValue ? c.ExpiresAt.Value.ToString("MMM d, yyyy") : "Never")</td>
                        <td>@c.TimesRedeemed@(c.MaxRedemptions.HasValue ? $" / {c.MaxRedemptions}" : "")</td>
                        <td>
                            @if (!c.IsActive)
                            {
                                <span class="status-pill rejected">Disabled</span>
                            }
                            else if (expired)
                            {
                                <span class="status-pill rejected">Expired</span>
                            }
                            else if (exhausted)
                            {
                                <span class="status-pill rejected">Exhausted</span>
                            }
                            else
                            {
                                <span class="status-pill approved">Active</span>
                            }
                        </td>
                        <td class="d-flex gap-2">
                            <form asp-action="ToggleCouponActive" asp-route-id="@c.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(c.IsActive ? "Disable" : "Enable")</button>
                            </form>
                            <form asp-action="DeleteCoupon" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Delete this coupon? This cannot be undone.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}
