@{
    ViewData["Title"] = "Admin Dashboard";
    int pendingCourses = (int)ViewBag.PendingCoursesCount;
    var monthly = (List<(DateTime Month, int Count)>)ViewBag.MonthlyRegistrations;
    int maxRegistrations = monthly.Count > 0 ? Math.Max(1, monthly.Max(m => m.Count)) : 1;
}

<div class="mb-4">
    <h2 class="section-title mb-1">Admin Dashboard</h2>
    <p class="text-muted-2">Platform overview and moderation queue.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-action="Users" class="text-decoration-none">
            <div class="stat-card stat-primary">
                <div class="stat-label">Total Users</div>
                <div class="stat-value">@ViewBag.TotalUsers</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="AllCourses" class="text-decoration-none">
            <div class="stat-card stat-info">
                <div class="stat-label">Total Courses</div>
                <div class="stat-value">@ViewBag.TotalCourses</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="AllEnrollments" class="text-decoration-none">
            <div class="stat-card stat-success">
                <div class="stat-label">Total Enrollments</div>
                <div class="stat-value">@ViewBag.TotalEnrollments</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="PendingCourses" class="text-decoration-none">
            <div class="stat-card stat-warning">
                <div class="stat-label">Pending Course Approvals</div>
                <div class="stat-value">@pendingCourses</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-action="Users" asp-route-role="Student" class="text-decoration-none">
            <div class="stat-card stat-primary">
                <div class="stat-label">Total Students</div>
                <div class="stat-value">@ViewBag.TotalStudents</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="Users" asp-route-role="Instructor" class="text-decoration-none">
            <div class="stat-card stat-info">
                <div class="stat-label">Total Instructors</div>
                <div class="stat-value">@ViewBag.TotalInstructors</div>
            </div>
        </a>
    </div>
</div>

<div class="card form-card mb-4">
    <h5 class="mb-3">New Registrations — Last 6 Months</h5>
    <div class="d-flex align-items-end gap-3" style="height:160px;">
        @foreach (var bar in monthly)
        {
            int heightPct = (int)(bar.Count * 100.0 / maxRegistrations);
            <div class="d-flex flex-column align-items-center justify-content-end h-100" style="flex:1;">
                <span class="small fw-semibold mb-1">@bar.Count</span>
                <div style="width:100%; max-width:48px; height:@(Math.Max(heightPct, 3))%; background:var(--color-primary); border-radius:4px 4px 0 0;"></div>
                <span class="small text-muted-2 mt-1">@bar.Month.ToString("MMM")</span>
            </div>
        }
    </div>
</div>

@if (pendingCourses > 0)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <span>
            <svg class="icon" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
            <strong>@pendingCourses</strong> course@(pendingCourses == 1 ? "" : "s") waiting for review.
        </span>
        <a asp-action="PendingCourses" class="btn btn-sm btn-warning">Review Now</a>
    </div>
}

<div class="d-flex gap-2">
    <a asp-controller="Category" asp-action="Index" asp-area="" class="btn btn-outline-secondary">Manage Categories</a>
    <a asp-action="Users" class="btn btn-outline-secondary">Manage Users</a>
    <a asp-action="PendingCourses" class="btn btn-outline-secondary">Pending Courses</a>
    <a asp-action="InstructorPins" class="btn btn-outline-secondary">Instructor PINs</a>
    <a asp-action="Revenue" class="btn btn-outline-secondary">Revenue Report</a>
</div>
