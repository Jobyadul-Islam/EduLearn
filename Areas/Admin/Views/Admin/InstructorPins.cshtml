@model List<EduLearn.Models.InstructorApplicationPin>

@{
    ViewData["Title"] = "Instructor Application PINs";
}

<a asp-action="Index" class="text-decoration-none small text-muted-2">← Back to Dashboard</a>

<div class="mb-4 mt-2">
    <h2 class="section-title mb-1">Instructor Application PINs</h2>
    <p class="text-muted-2">Generate a one-time PIN and email it to whoever requested it. They'll use it at the Apply page to fill out their instructor application.</p>
</div>

@if (TempData["NewPinCode"] != null)
{
    <div class="alert alert-success">
        <strong>New PIN generated:</strong>
        <span class="code-badge ms-2" style="font-size:1.1rem;">@TempData["NewPinCode"]</span>
        — copy this and send it to the applicant by email.
    </div>
}

<form asp-action="GeneratePin" method="post" class="mb-4">
    <button type="submit" class="btn btn-primary">+ Generate New PIN</button>
</form>

<div class="card">
    <div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>PIN</th>
                <th>Status</th>
                <th>Generated</th>
                <th>Used</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted-2 py-4">No PINs generated yet.</td>
                </tr>
            }
            @foreach (var pin in Model)
            {
                <tr>
                    <td><span class="code-badge">@pin.Code</span></td>
                    <td>
                        @if (pin.IsUsed)
                        {
                            <span class="status-pill rejected">Used</span>
                        }
                        else
                        {
                            <span class="status-pill approved">Available</span>
                        }
                    </td>
                    <td class="small text-muted-2">@pin.CreatedAt.ToString("g")</td>
                    <td class="small text-muted-2">@(pin.UsedAt?.ToString("g") ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
