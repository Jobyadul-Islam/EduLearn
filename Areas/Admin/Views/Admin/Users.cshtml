@model List<EduLearn.Models.ViewModels.UserListItemViewModel>

@{
    ViewData["Title"] = "Manage Users";
    string? searchTerm = ViewBag.SearchTerm;
    string roleFilter = ViewBag.RoleFilter;
    string statusFilter = ViewBag.StatusFilter;
    string currentUserId = ViewBag.CurrentUserId;
    bool hasActiveFilters = !string.IsNullOrWhiteSpace(searchTerm) || roleFilter != "All" || statusFilter != "All";
    var emailResult = TempData["EmailResult"] as string;
    var infoType = "info";
}

@section Toasts {
    @if (emailResult != null)
    {
        <partial name="_Toast" model="(emailResult, infoType)" />
    }
}

<a asp-action="Index" class="text-decoration-none small text-muted-2">← Back to Dashboard</a>

<div class="mb-4 mt-2">
    <h2 class="section-title mb-1">Manage Users</h2>
    <p class="text-muted-2">Approve pending instructors and manage account access.</p>
</div>

<form asp-action="Users" method="get" class="row g-2 align-items-center mb-3">
    <div class="col-sm-5 col-md-4">
        <label for="userSearchInput" class="visually-hidden">Search users by email</label>
        <div class="search-bar" style="max-width:none;">
            <input type="text" id="userSearchInput" name="search" class="form-control" placeholder="Search by email..." value="@searchTerm" />
            <button type="submit" class="btn btn-primary" aria-label="Search">
                <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </button>
        </div>
    </div>
    <div class="col-sm-3 col-md-2">
        <label for="roleFilterSelect" class="visually-hidden">Filter by role</label>
        <select id="roleFilterSelect" name="role" class="form-select" onchange="this.form.submit()">
            <option value="All" selected="@(roleFilter == "All" ? "selected" : null)">All Roles</option>
            <option value="Admin" selected="@(roleFilter == "Admin" ? "selected" : null)">Admin</option>
            <option value="Instructor" selected="@(roleFilter == "Instructor" ? "selected" : null)">Instructor</option>
            <option value="Student" selected="@(roleFilter == "Student" ? "selected" : null)">Student</option>
        </select>
    </div>
    <div class="col-sm-3 col-md-2">
        <label for="statusFilterSelect" class="visually-hidden">Filter by status</label>
        <select id="statusFilterSelect" name="status" class="form-select" onchange="this.form.submit()">
            <option value="All" selected="@(statusFilter == "All" ? "selected" : null)">All Statuses</option>
            <option value="Active" selected="@(statusFilter == "Active" ? "selected" : null)">Active</option>
            <option value="Deactivated" selected="@(statusFilter == "Deactivated" ? "selected" : null)">Deactivated</option>
        </select>
    </div>
    @if (hasActiveFilters)
    {
        <div class="col-sm-auto">
            <a asp-action="Users" class="btn btn-outline-secondary">Clear filters</a>
        </div>
    }
</form>

@if (hasActiveFilters)
{
    <p class="text-muted-2 mb-3">Showing @Model.Count matching user@(Model.Count == 1 ? "" : "s")</p>
}

<div class="card">
    <div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Approval</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted-2 py-4">No users match these filters.</td>
                </tr>
            }
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td><span class="badge text-bg-light border">@user.Role</span></td>
                    <td>
                        @if (user.Role == "Instructor")
                        {
                            if (user.IsApproved)
                            {
                                <span class="status-pill approved">Approved</span>
                            }
                            else if (user.IsRejected)
                            {
                                <span class="status-pill rejected">Rejected</span>
                            }
                            else
                            {
                                <span class="status-pill pending">Pending</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted-2">—</span>
                        }
                    </td>
                    <td>
                        @if (user.Role == "Instructor" && user.IsRejected)
                        {
                            <span class="status-pill rejected">Rejected</span>
                        }
                        else if (user.IsActive)
                        {
                            <span class="status-pill approved">Active</span>
                        }
                        else
                        {
                            <span class="status-pill rejected">Deactivated</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Profile" asp-action="Index" asp-area="" asp-route-userId="@user.Id" class="btn btn-sm btn-outline-secondary">View Profile</a>

                            @if (user.Role == "Instructor" && !user.IsApproved && !user.IsRejected)
                            {
                                <a asp-action="ViewApplication" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">View Application</a>
                                <button type="button" class="btn btn-sm btn-success text-nowrap" data-bs-toggle="modal" data-bs-target="#approveModal-@user.Id">Approve & Email</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@user.Id">Reject</button>
                            }
                            @if (user.Id == currentUserId)
                            {
                                <span class="badge text-bg-light border align-self-center">This is you</span>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#toggleActiveModal-@user.Id">
                                    @(user.IsActive ? "Deactivate" : "Activate")
                                </button>
                            }
                        </div>

                        @if (user.Role == "Instructor" && !user.IsApproved && !user.IsRejected)
                        {
                            <div class="modal fade" id="approveModal-@user.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="Approve" asp-route-id="@user.Id" method="post">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Approve Instructor</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">Approve <strong>@user.FullName</strong> as an instructor? They'll be emailed a link to set their password and start teaching.</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                                                <button type="submit" class="btn btn-success">Yes, Approve</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <div class="modal fade" id="rejectModal-@user.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="Reject" asp-route-id="@user.Id" method="post">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Reject Application</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">Reject <strong>@user.FullName</strong>'s instructor application? This can't be undone from this page.</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                                                <button type="submit" class="btn btn-danger">Yes, Reject</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (user.Id != currentUserId)
                        {
                            <div class="modal fade" id="toggleActiveModal-@user.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post">
                                            <div class="modal-header">
                                                <h5 class="modal-title">@(user.IsActive ? "Deactivate" : "Activate") Account</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                @if (user.IsActive)
                                                {
                                                    <p class="mb-0">Deactivate <strong>@user.FullName</strong>'s account? They won't be able to log in until reactivated.</p>
                                                }
                                                else
                                                {
                                                    <p class="mb-0">Reactivate <strong>@user.FullName</strong>'s account?</p>
                                                }
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                                                <button type="submit" class="btn @(user.IsActive ? "btn-danger" : "btn-success")">Yes, @(user.IsActive ? "Deactivate" : "Activate")</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>