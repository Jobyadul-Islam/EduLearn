@model List<EduLearn.Models.Course>

@{
    ViewData["Title"] = "All Courses";
}

<a asp-action="Index" class="text-decoration-none small text-muted-2">← Back to Dashboard</a>

<div class="mb-4 mt-2">
    <h2 class="section-title mb-1">All Courses</h2>
    <p class="text-muted-2">Every course on EduLearn, regardless of status.</p>
</div>

<div class="card">
    <div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Instructor</th>
                <th>Price</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted-2 py-4">No courses yet.</td>
                </tr>
            }
            @foreach (var course in Model)
            {
                <tr>
                    <td>
                        <span class="code-badge me-2">@course.CourseCode</span>@course.Title
                    </td>
                    <td>@course.Category?.Name</td>
                    <td>@course.Instructor?.FullName</td>
                    <td>@(course.Price == 0 ? "Free" : $"TK {course.Price}")</td>
                    <td>
                        @switch (course.Status)
                        {
                            case EduLearn.Models.CourseStatus.Approved:
                                <span class="status-pill approved">Approved</span>
                                break;
                            case EduLearn.Models.CourseStatus.Pending:
                                <span class="status-pill pending">Pending</span>
                                break;
                            default:
                                <span class="status-pill rejected">Rejected</span>
                                break;
                        }
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="CourseOverview" asp-route-id="@course.Id" class="btn btn-sm btn-outline-info">Overview</a>
                            <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" asp-area="" target="_blank" class="btn btn-sm btn-outline-secondary">View</a>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editPriceModal-@course.Id">Edit Price</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@course.Id">Delete</button>
                        </div>

                        <div class="modal fade" id="editPriceModal-@course.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-action="EditCoursePrice" asp-route-id="@course.Id" method="post">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Edit Price — "@course.Title"</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <label for="priceInput-@course.Id" class="form-label">Price in TK (0 = Free)</label>
                                            <input type="number" name="price" id="priceInput-@course.Id" class="form-control" min="0" step="1" value="@course.Price" />
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary">Save Price</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" id="deleteModal-@course.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-action="DeleteCourse" asp-route-id="@course.Id" method="post">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Delete "@course.Title"</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p class="mb-0">This permanently deletes the course along with all its modules, lessons, quizzes, assignments, enrollments, payments, and reviews. This can't be undone.</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger">Yes, Delete Permanently</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
