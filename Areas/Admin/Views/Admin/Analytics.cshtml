@{
    ViewData["Title"] = "Course Analytics";
    var mostPopular = (List<(int Id, string Title, int EnrollmentCount)>)ViewBag.MostPopular;
    var topRated = (List<(int Id, string Title, int ReviewCount, double? AverageRating)>)ViewBag.TopRated;
}

<a asp-action="Index" class="text-decoration-none small text-muted-2">← Back to Dashboard</a>

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4 mt-2">
    <div>
        <h2 class="section-title mb-1">Course Analytics</h2>
        <p class="text-muted-2 mb-0">Most popular and highest-rated courses across the platform.</p>
    </div>
    <a asp-action="ExportAnalyticsPdf" class="btn btn-outline-primary">Export PDF</a>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card form-card h-100">
            <h5 class="mb-3">Most Popular Courses</h5>
            @if (!mostPopular.Any(c => c.EnrollmentCount > 0))
            {
                <p class="text-muted-2 mb-0">No enrollments yet.</p>
            }
            else
            {
                <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Course</th>
                            <th>Enrollments</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rank = 1; }
                        @foreach (var course in mostPopular)
                        {
                            <tr>
                                <td>@rank</td>
                                <td>@course.Title</td>
                                <td>@course.EnrollmentCount</td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card form-card h-100">
            <h5 class="mb-3">Top Rated Courses</h5>
            @if (!topRated.Any())
            {
                <p class="text-muted-2 mb-0">No reviews yet.</p>
            }
            else
            {
                <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Course</th>
                            <th>Rating</th>
                            <th>Reviews</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rank2 = 1; }
                        @foreach (var course in topRated)
                        {
                            <tr>
                                <td>@rank2</td>
                                <td>@course.Title</td>
                                <td>@(course.AverageRating?.ToString("0.0")) / 5</td>
                                <td>@course.ReviewCount</td>
                            </tr>
                            rank2++;
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>
    </div>
</div>
