@model EduLearn.Models.ApplicationUser

@{
    ViewData["Title"] = "Instructor Application";
}

<a asp-action="Users" class="text-decoration-none small text-muted-2">← Back to Manage Users</a>

<div class="mb-4 mt-2 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h2 class="section-title mb-1">@Model.FullName</h2>
        <p class="text-muted-2 mb-0">@Model.Email</p>
    </div>
    @if (!Model.IsApproved)
    {
        <div class="d-flex gap-2">
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-success">Approve</button>
            </form>
            <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-danger">Reject</button>
            </form>
        </div>
    }
    else
    {
        <span class="status-pill approved">Already Approved</span>
    }
</div>

<div class="card form-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">Phone Number</dt>
        <dd class="col-sm-9">@(Model.PhoneNumber ?? "—")</dd>

        <dt class="col-sm-3">Qualification</dt>
        <dd class="col-sm-9">@(Model.Qualification ?? "—")</dd>

        <dt class="col-sm-3">Institution</dt>
        <dd class="col-sm-9">@(Model.Institution ?? "—")</dd>

        <dt class="col-sm-3">Skills / Expertise</dt>
        <dd class="col-sm-9">@(Model.Skills ?? "—")</dd>

        <dt class="col-sm-3">Years of Experience</dt>
        <dd class="col-sm-9">@(Model.YearsOfExperience?.ToString() ?? "—")</dd>

        <dt class="col-sm-3">Bio</dt>
        <dd class="col-sm-9">@(Model.Bio ?? "—")</dd>
    </dl>
</div>
