@model EduLearn.Models.Course

@{
    ViewData["Title"] = Model.Title;
}

<h2>@Model.Title</h2>
<p>@Model.Description</p>

<a asp-action="CreateModule" asp-route-courseId="@Model.Id" class="btn btn-primary mb-3">+ Add Module</a>

@foreach (var module in Model.Modules)
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>@module.Title</strong>
            <a asp-action="CreateLesson" asp-route-moduleId="@module.Id" class="btn btn-sm btn-secondary float-end">+ Add Lesson</a>
        </div>
        <ul class="list-group list-group-flush">
            @foreach (var lesson in module.Lessons)
            {
                <li class="list-group-item">
                    @lesson.Title
                    @if (!string.IsNullOrEmpty(lesson.FilePath))
                    {
                        <a href="@lesson.FilePath" target="_blank" class="ms-2">[View File]</a>
                    }
                    <a asp-action="CreateAssignment" asp-route-lessonId="@lesson.Id" class="btn btn-sm btn-outline-secondary float-end">+ Add Assignment</a>
                    <a asp-action="CreateQuiz" asp-route-lessonId="@lesson.Id" class="btn btn-sm btn-outline-info float-end me-2">+ Add Quiz</a>
                </li>
            }
        </ul>
    </div>
}

<a asp-action="Index" class="btn btn-link">Back to My Courses</a>