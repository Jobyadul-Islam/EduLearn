@model EduLearn.Models.Module

@{
    ViewData["Title"] = "Add Module";
}

<div class="mx-auto" style="max-width:520px;">
    <h2 class="section-title mb-4">Add Module</h2>

    <div class="card form-card">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <form asp-action="CreateModule" method="post">
            <input type="hidden" name="CourseId" value="@ViewBag.CourseId" />
            <div class="mb-3">
                <label asp-for="Title" class="form-label">Module Title</label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="CourseDetails" asp-route-id="@ViewBag.CourseId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
