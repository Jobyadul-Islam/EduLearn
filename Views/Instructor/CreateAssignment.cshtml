@model EduLearn.Models.Assignment

@{
    ViewData["Title"] = "Add Assignment";
}

<h2>Add Assignment</h2>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="CreateAssignment" method="post">
    <input type="hidden" name="LessonId" value="@ViewBag.LessonId" />
    <div class="mb-3">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label>Due Date</label>
        <input asp-for="DueDate" type="datetime-local" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>