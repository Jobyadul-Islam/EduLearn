@model EduLearn.Models.Course

@{
    ViewData["Title"] = "Edit Course";
}

<div class="mx-auto" style="max-width:640px;">
    <h2 class="section-title mb-3">Edit Course</h2>
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
        <svg class="icon" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
        <span>Saving changes will send this course back to Admin for re-approval.</span>
    </div>

    <div class="card form-card">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <form asp-action="EditCourse" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Price ($)</label>
                <input asp-for="Price" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Category</label>
                <select asp-for="CategoryId" class="form-select">
                    @foreach (var cat in (List<EduLearn.Models.Category>)ViewBag.Categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>
            @if (!string.IsNullOrEmpty(Model.ThumbnailPath))
            {
                <div class="mb-3">
                    <img src="@Model.ThumbnailPath" style="max-height:120px; border-radius:var(--radius-sm);" class="d-block mb-2" />
                </div>
            }
            <div class="mb-4">
                <label class="form-label">Replace Thumbnail Image</label>
                <input type="file" name="Thumbnail" class="form-control" accept="image/*" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save & Resubmit</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
