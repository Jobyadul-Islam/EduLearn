@model EduLearn.Models.Lesson

@{
    ViewData["Title"] = "Add Lesson";
}

<div class="mx-auto" style="max-width:600px;">
    <h2 class="section-title mb-4">Add Lesson</h2>

    <div class="card form-card">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <form asp-action="CreateLesson" method="post" enctype="multipart/form-data">
            <input type="hidden" name="ModuleId" value="@ViewBag.ModuleId" />
            <div class="mb-3">
                <label asp-for="Title" class="form-label">Lesson Title</label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Content" class="form-label">Content</label>
                <textarea asp-for="Content" class="form-control" rows="4"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="VideoUrl" class="form-label">Video URL (optional)</label>
                <input asp-for="VideoUrl" class="form-control" />
            </div>
            <div class="mb-4">
                <label for="lessonFileInput" class="form-label">Upload File (video/PDF)</label>
                <input type="file" id="lessonFileInput" name="LessonFile" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>
