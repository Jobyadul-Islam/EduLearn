@using EduLearn.Models
@model List<Course>

@{
    ViewData["Title"] = "My Courses";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <div>
        <h2 class="section-title mb-1">My Courses</h2>
        <p class="text-muted-2 mb-0">Manage the courses you teach on EduLearn.</p>
    </div>
    @if ((bool)ViewBag.IsApproved)
    {
        <a asp-action="CreateCourse" class="btn btn-primary">+ Add Course</a>
    }
</div>

@if (!(bool)ViewBag.IsApproved)
{
    <div class="alert alert-warning d-flex align-items-center gap-2">
        <svg class="icon" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
        <span>Your instructor account is pending Admin approval. You can't publish new courses until an admin approves your account.</span>
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <svg class="icon" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
        <p class="mb-0">You haven't created any courses yet.</p>
    </div>
}
else
{
    <div class="row">
        @{ int cardIndex = 0; }
        @foreach (var course in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(course.ThumbnailPath))
                    {
                        <img src="@course.ThumbnailPath" class="card-img-top" alt="@course.Title" style="height:170px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="course-thumb-placeholder accent-@(cardIndex % 5)">
                            <svg class="icon" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="code-badge">@course.CourseCode</span>
                            @if (course.Status == CourseStatus.Pending)
                            {
                                <span class="status-pill pending">Pending Review</span>
                            }
                            else if (course.Status == CourseStatus.Approved)
                            {
                                <span class="status-pill approved">Approved</span>
                            }
                            else
                            {
                                <span class="status-pill rejected">Rejected</span>
                            }
                        </div>
                        <h5 class="card-title">@course.Title</h5>
                        @if (course.Status == CourseStatus.Rejected && !string.IsNullOrEmpty(course.RejectionReason))
                        {
                            <p class="small text-danger mb-2">Reason: @course.RejectionReason</p>
                        }
                        <p class="card-text"><strong>@(course.Price == 0 ? "Free" : $"${course.Price}")</strong></p>
                        <div class="mt-auto d-flex flex-wrap gap-2">
                            <a asp-action="CourseDetails" asp-route-id="@course.Id" class="btn btn-sm btn-outline-primary">Manage Content</a>
                            <a asp-action="EditCourse" asp-route-id="@course.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="DeleteCourse" asp-route-id="@course.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
            cardIndex++;
        }
    </div>
}
