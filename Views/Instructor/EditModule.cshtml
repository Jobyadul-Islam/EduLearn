@model EduLearn.Models.Module

@{
    ViewData["Title"] = "Edit Module";
}

<div class="mx-auto" style="max-width:520px;">
    <h2 class="section-title mb-4">Edit Module</h2>

    <div class="card form-card">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <form asp-action="EditModule" asp-route-id="@Model.Id" method="post">
            <div class="mb-3">
                <label asp-for="Title" class="form-label">Module Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="CourseDetails" asp-route-id="@Model.CourseId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
