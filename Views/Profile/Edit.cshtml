@model EduLearn.Models.ProfileEditViewModel
@{
    ViewData["Title"] = "Edit Profile";
    var avatarSrc = string.IsNullOrEmpty(Model.CurrentProfilePicture) ? "/image/user-circles-set_78370-4704.avif" : Model.CurrentProfilePicture;
}

<div class="auth-card" style="max-width:520px;">
    <div class="card form-card">
        <h4 class="section-title mb-4">Edit Profile</h4>
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div class="text-center mb-4">
                <img src="@avatarSrc" alt="Current profile picture"
                     class="rounded-circle mb-3"
                     style="width:100px;height:100px;object-fit:cover;border:1px solid var(--color-border);" />
            </div>

            <div class="mb-3" data-picture-cropper>
                <label asp-for="NewProfilePicture" class="form-label">Change Profile Picture</label>
                <input asp-for="NewProfilePicture" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" data-cropper-file-input />
                <span asp-validation-for="NewProfilePicture" class="text-danger"></span>
                <div class="form-text">Leave empty to keep your current picture.</div>
                <div class="d-none mt-3 text-center" data-cropper-stage>
                    <div data-cropper-viewport style="width:180px;height:180px;border-radius:50%;overflow:hidden;position:relative;margin:0 auto;cursor:grab;background:var(--color-bg);border:1px solid var(--color-border);touch-action:none;">
                        <img data-cropper-image style="position:absolute;max-width:none;user-select:none;" alt="" />
                    </div>
                    <label class="visually-hidden" for="profileEditZoomSlider">Zoom photo</label>
                    <input type="range" id="profileEditZoomSlider" data-cropper-zoom min="100" max="300" value="100" class="form-range mt-2 mx-auto d-block" style="max-width:180px;" />
                    <p class="text-muted-2 small mt-1 mb-0">Drag the photo to reposition it</p>
                </div>
                <span class="text-danger d-block small mt-1" data-cropper-error></span>
                <input asp-for="CroppedPictureData" type="hidden" data-cropper-output />
            </div>

            <div class="mb-4">
                <label asp-for="Bio" class="form-label">Bio</label>
                <textarea asp-for="Bio" class="form-control" rows="3" maxlength="500"></textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Save Changes</button>
                <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-primary">Cancel</a>
            </div>
        </form>
    </div>
</div>