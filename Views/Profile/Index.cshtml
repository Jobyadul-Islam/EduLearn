@model EduLearn.Models.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    var avatarSrc = string.IsNullOrEmpty(Model.ProfilePicture) ? "/image/user-circles-set_78370-4704.avif" : Model.ProfilePicture;
}

<div class="auth-card" style="max-width:520px;">
    <div class="card form-card text-center">
        <img src="@avatarSrc" alt="Profile picture"
             class="rounded-circle mx-auto mb-3"
             style="width:120px;height:120px;object-fit:cover;border:1px solid var(--color-border);" />

        <h4 class="mb-1">@Model.FullName</h4>
        <p class="text-muted-2 mb-1">@Model.Email</p>
        <span class="status-pill approved mb-3 d-inline-flex">@Model.Role</span>

        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <p class="mt-3 mb-0">@Model.Bio</p>
        }
        else if (Model.IsViewingOwnProfile)
        {
            <p class="text-muted-2 mt-3 mb-0 fst-italic">You haven't added a bio yet.</p>
        }

        @if (Model.IsViewingOwnProfile)
        {
            <a asp-controller="Profile" asp-action="Edit" class="btn btn-primary mt-4">Edit Profile</a>
        }
    </div>
</div>