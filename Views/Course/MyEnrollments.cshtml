@model List<EduLearn.Models.Enrollment>

@{
    ViewData["Title"] = "My Enrollments";
    var progress = (Dictionary<int, int>)ViewBag.ProgressByCourseId;
    var nextLesson = (Dictionary<int, int?>)ViewBag.NextLessonByCourseId;
    var deadlines = (List<EduLearn.Models.Assignment>)ViewBag.UpcomingDeadlines;
    var reviewedCourseIds = (List<int>)ViewBag.ReviewedCourseIds;
}

<div class="mb-4">
    <h2 class="section-title">My Enrolled Courses</h2>
    <p class="text-muted-2">Pick up where you left off.</p>
</div>

@if (TempData["CertificateError"] != null)
{
    <div class="alert alert-warning">@TempData["CertificateError"]</div>
}

@if (TempData["ReviewError"] != null)
{
    <div class="alert alert-warning">@TempData["ReviewError"]</div>
}

@if (deadlines != null && deadlines.Any())
{
    <div class="card form-card mb-4">
        <h5 class="mb-3">Upcoming Deadlines</h5>
        <ul class="list-unstyled mb-0">
            @foreach (var assignment in deadlines)
            {
                <li class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <div>
                        <a asp-action="SubmitAssignment" asp-route-assignmentId="@assignment.Id" class="fw-semibold text-decoration-none">@assignment.Title</a>
                        <span class="text-muted-2 small"> — @assignment.Lesson.Module.Course.Title</span>
                    </div>
                    <span class="status-pill pending">Due @assignment.DueDate.ToShortDateString()</span>
                </li>
            }
        </ul>
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <svg class="icon" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
        <p class="mb-3">You haven't enrolled in any courses yet.</p>
        <a asp-action="Index" class="btn btn-primary">Browse Courses</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var enrollment in Model)
        {
            var pct = progress.TryGetValue(enrollment.CourseId, out var p) ? p : 0;
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(enrollment.Course.ThumbnailPath))
                    {
                        <img src="@enrollment.Course.ThumbnailPath" class="card-img-top" style="height:150px; object-fit:cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="code-badge">@enrollment.Course.CourseCode</span>
                            @if (enrollment.Course.Price > 0)
                            {
                                if (enrollment.Status == EduLearn.Models.EnrollmentStatus.Active)
                                {
                                    <span class="status-pill approved">Paid</span>
                                }
                                else
                                {
                                    <span class="status-pill pending">Free Preview</span>
                                }
                            }
                        </div>
                        <h5 class="card-title">@enrollment.Course.Title</h5>
                        <p class="card-text small text-muted-2">Enrolled on @enrollment.EnrollDate.ToShortDateString()</p>
                        <div class="mb-2">
                            <div class="d-flex justify-content-between small text-muted-2 mb-1">
                                <span>Progress</span>
                                <span>@pct%</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar" role="progressbar" style="width:@pct%" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                        @{
                            var isActive = enrollment.Status == EduLearn.Models.EnrollmentStatus.Active;
                        }
                        @if (enrollment.Course.Price > 0 && !isActive)
                        {
                            <a asp-action="Checkout" asp-route-courseId="@enrollment.CourseId" class="btn btn-success mt-auto mb-2">Unlock Full Course — TK @enrollment.Course.Price</a>
                        }
                        @if (pct == 100)
                        {
                            <a asp-action="Certificate" asp-route-courseId="@enrollment.CourseId" class="btn btn-outline-success mb-2">Download Certificate</a>
                            @if (reviewedCourseIds.Contains(enrollment.CourseId))
                            {
                                <span class="text-muted-2 small mb-2">You've reviewed this course</span>
                            }
                            else
                            {
                                <a asp-action="WriteReview" asp-route-courseId="@enrollment.CourseId" class="btn btn-outline-primary mb-2">Write a Review</a>
                            }
                        }
                        @{
                            var nextLessonId = nextLesson.TryGetValue(enrollment.CourseId, out var nl) ? nl : null;
                        }
                        @if (nextLessonId.HasValue && (enrollment.Course.Price == 0 || isActive))
                        {
                            <a asp-action="ViewLesson" asp-route-id="@nextLessonId" class="btn btn-outline-primary @(enrollment.Course.Price > 0 && !isActive ? "" : "mt-auto")">Continue Learning</a>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@enrollment.CourseId" class="btn btn-outline-primary @(enrollment.Course.Price > 0 && !isActive ? "" : "mt-auto")">Continue Learning</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
