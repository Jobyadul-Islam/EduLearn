@model EduLearn.Models.Course

@{
    ViewData["Title"] = "Checkout";
}

<div class="mx-auto" style="max-width:480px;">
    <h2 class="section-title mb-1">Unlock Full Course</h2>
    <p class="text-muted-2 mb-4">You've completed the free preview. Purchase this course to unlock every lesson.</p>

    <div class="card form-card">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="code-badge">@Model.CourseCode</span>
            <span class="badge text-bg-light border">@Model.Category?.Name</span>
        </div>
        <h5 class="mb-3">@Model.Title</h5>

        <div class="d-flex justify-content-between align-items-center border-top border-bottom py-3 mb-4">
            <span class="text-muted-2">Total</span>
            <span class="fs-3 fw-bold">$@Model.Price</span>
        </div>

        <div class="alert alert-secondary small">
            This is a simulated checkout for demo purposes — no real payment is processed. Clicking "Confirm Payment" immediately unlocks the course.
        </div>

        <form asp-action="ConfirmPayment" method="post">
            <input type="hidden" name="courseId" value="@Model.Id" />
            <button type="submit" class="btn btn-success w-100">Confirm Payment — $@Model.Price</button>
        </form>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link w-100 mt-2">Cancel</a>
    </div>
</div>
