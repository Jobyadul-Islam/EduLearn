@model EduLearn.Models.Course

@{
    ViewData["Title"] = Model.Title;
    var freeLessonIds = (List<int>)ViewBag.FreeLessonIds;
    bool hasFullAccess = (bool)ViewBag.HasFullAccess;
}

@if (Model.Status != EduLearn.Models.CourseStatus.Approved)
{
    <div class="alert alert-warning d-flex align-items-center gap-2">
        <svg class="icon" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
        <span>
            This course is <strong>@Model.Status.ToString().ToLower()</strong> and is only visible to you as a preview.
            @if (Model.Status == EduLearn.Models.CourseStatus.Rejected && !string.IsNullOrEmpty(Model.RejectionReason))
            {
                <text> Reason: @Model.RejectionReason</text>
            }
        </span>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        @if (!string.IsNullOrEmpty(Model.ThumbnailPath))
        {
            <img src="@Model.ThumbnailPath" class="img-fluid rounded mb-3" style="max-height:320px; object-fit:cover; width:100%;" />
        }
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="code-badge">@Model.CourseCode</span>
            <span class="badge text-bg-light border">@Model.Category?.Name</span>
        </div>
        <h2 class="mb-1">@Model.Title</h2>
        @if (Model.Instructor != null)
        {
            <p class="text-muted-2">Taught by <strong>@Model.Instructor.FullName</strong></p>
        }
        <p class="mt-3">@Model.Description</p>

        <h4 class="mt-4 section-title h5">Course Content</h4>
        @if (Model.Price > 0 && !hasFullAccess)
        {
            <p class="small text-muted-2 mb-2">The first 2 lessons are free to preview. Unlock the rest by purchasing the course.</p>
        }
        @if (!Model.Modules.Any())
        {
            <p class="text-muted-2">Content for this course hasn't been added yet.</p>
        }
        @foreach (var module in Model.Modules)
        {
            <div class="card mb-2">
                <div class="card-header bg-white"><strong>@module.Title</strong></div>
                <ul class="list-group list-group-flush">
                    @foreach (var lesson in module.Lessons)
                    {
                        bool isFree = freeLessonIds.Contains(lesson.Id);
                        bool locked = !hasFullAccess && !isFree;
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @if (locked)
                            {
                                <span class="text-muted-2">
                                    <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    @lesson.Title
                                </span>
                                <span class="badge text-bg-light border">Locked</span>
                            }
                            else
                            {
                                <a asp-action="ViewLesson" asp-route-id="@lesson.Id">@lesson.Title</a>
                                @if (isFree && Model.Price > 0)
                                {
                                    <span class="badge text-bg-light border">Free Preview</span>
                                }
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card" style="position:sticky; top:1rem;">
            <div class="card-body text-center">
                <h3 class="mb-3">@(Model.Price == 0 ? "Free" : $"${Model.Price}")</h3>
                @if (User.IsInRole("Instructor"))
                {
                    <p class="text-muted-2 small mb-2">Instructor accounts don't enroll in courses.</p>
                    <a asp-controller="Instructor" asp-action="Index" asp-area="" class="btn btn-outline-primary w-100">Go to My Dashboard</a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <p class="text-muted-2 small mb-2">Admin accounts don't enroll in courses.</p>
                    <a asp-controller="Admin" asp-action="Index" asp-area="Admin" class="btn btn-outline-primary w-100">Go to Admin Dashboard</a>
                }
                else if (User.Identity.IsAuthenticated)
                {
                    @if ((bool)ViewBag.IsEnrolled)
                    {
                        @if (hasFullAccess)
                        {
                            <div class="alert alert-success text-center">You have full access to this course</div>
                        }
                        else
                        {
                            <div class="alert alert-warning text-center">Enrolled — free preview only</div>
                            <a asp-action="Checkout" asp-route-courseId="@Model.Id" class="btn btn-success w-100 mb-2">Unlock Full Course — $@Model.Price</a>
                        }
                        <a asp-action="MyEnrollments" class="btn btn-outline-primary w-100">Go to My Enrollments</a>
                    }
                    else if (Model.Status == EduLearn.Models.CourseStatus.Approved)
                    {
                        @if (Model.Price > 0)
                        {
                            <p class="small text-muted-2 mb-2">Enroll free to preview the first 2 lessons.</p>
                        }
                        <form asp-action="Enroll" method="post">
                            <input type="hidden" name="courseId" value="@Model.Id" />
                            <button type="submit" class="btn btn-success w-100">Enroll Now</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100" disabled>Not Yet Published</button>
                    }
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-success w-100">Login to Enroll</a>
                }
            </div>
        </div>
    </div>
</div>
