@model EduLearn.Models.Course

@{
    ViewData["Title"] = Model.Title;
}

<div class="row">
    <div class="col-md-8">
        @if (!string.IsNullOrEmpty(Model.ThumbnailPath))
        {
            <img src="@Model.ThumbnailPath" class="img-fluid rounded mb-3" />
        }
        <h2>@Model.Title</h2>
        <span class="badge bg-secondary">@Model.Category?.Name</span>
        <p class="mt-3">@Model.Description</p>

        <h4 class="mt-4">Course Content</h4>
        @foreach (var module in Model.Modules)
        {
            <div class="card mb-2">
                <div class="card-header"><strong>@module.Title</strong></div>
                <ul class="list-group list-group-flush">
                    @foreach (var lesson in module.Lessons)
                    {
                        <li class="list-group-item">
                            <a asp-action="ViewLesson" asp-route-id="@lesson.Id">@lesson.Title</a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h3>$@Model.Price</h3>
                @if (User.Identity.IsAuthenticated)
                {
                    @if ((bool)ViewBag.IsEnrolled)
                    {
                        <div class="alert alert-success text-center">✓ You are enrolled in this course</div>
                        <a asp-action="MyEnrollments" class="btn btn-outline-primary w-100">Go to My Enrollments</a>
                    }
                    else
                    {
                        <form asp-action="Enroll" method="post">
                            <input type="hidden" name="courseId" value="@Model.Id" />
                            <button type="submit" class="btn btn-success w-100">Enroll Now</button>
                        </form>
                    }
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-success w-100">Login to Enroll</a>
                }
            </div>
        </div>
    </div>
</div>