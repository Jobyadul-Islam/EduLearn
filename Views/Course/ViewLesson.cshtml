@model EduLearn.Models.Lesson

@{
    ViewData["Title"] = Model.Title;
    var submittedIds = (List<int>)ViewBag.SubmittedAssignmentIds;
    var quizResults = (Dictionary<int, EduLearn.Models.QuizResult>)ViewBag.QuizResultsByQuizId;
}

<a asp-action="Details" asp-route-id="@Model.Module.CourseId" class="text-decoration-none small text-muted-2">← Back to Course</a>

<div class="d-flex justify-content-between align-items-start mt-2 mb-3">
    <h2 class="mb-0">@Model.Title</h2>
    <div class="d-flex gap-2">
        @if ((bool)ViewBag.IsFreePreview)
        {
            <span class="badge text-bg-light border">Free Preview</span>
        }
        @if ((bool)ViewBag.IsCompleted)
        {
            <span class="status-pill approved">
                <svg class="icon" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                Completed
            </span>
        }
    </div>
</div>

@if (!(bool)ViewBag.IsCompleted)
{
    <form asp-action="MarkComplete" method="post" class="mb-3">
        <input type="hidden" name="lessonId" value="@Model.Id" />
        <button type="submit" class="btn btn-outline-success">Mark as Complete</button>
    </form>
}

<div class="card form-card mb-3">
    <p class="mb-0">@Model.Content</p>
</div>

@if (!string.IsNullOrEmpty(Model.VideoUrl))
{
    <div class="mb-3">
        <strong>Video:</strong> <a href="@Model.VideoUrl" target="_blank">@Model.VideoUrl</a>
    </div>
}

@if (!string.IsNullOrEmpty(Model.FilePath))
{
    <div class="mb-3">
        <a href="@Model.FilePath" target="_blank" class="btn btn-outline-primary">Download / View File</a>
    </div>
}

@if (Model.Assignments != null && Model.Assignments.Any())
{
    <h4 class="mt-4 section-title h5">Assignments</h4>
    @foreach (var assignment in Model.Assignments)
    {
        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="mb-1">@assignment.Title</h5>
                    <p class="mb-1 text-muted-2 small">@assignment.Description</p>
                    <p class="mb-0"><small class="text-muted-2">Due: @assignment.DueDate.ToShortDateString()</small></p>
                </div>
                <div class="text-end">
                    @if (submittedIds.Contains(assignment.Id))
                    {
                        <div class="mb-2"><span class="status-pill approved">Submitted</span></div>
                        <a asp-action="SubmitAssignment" asp-route-assignmentId="@assignment.Id" class="btn btn-sm btn-outline-primary">Resubmit</a>
                    }
                    else
                    {
                        <a asp-action="SubmitAssignment" asp-route-assignmentId="@assignment.Id" class="btn btn-sm btn-primary">Submit Assignment</a>
                    }
                </div>
            </div>
        </div>
    }
}

@if (Model.Quizzes != null && Model.Quizzes.Any())
{
    <h4 class="mt-4 section-title h5">Quizzes</h4>
    @foreach (var quiz in Model.Quizzes)
    {
        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="mb-1">@quiz.Title</h5>
                    <p class="mb-0 text-muted-2 small">@quiz.Questions.Count question@(quiz.Questions.Count == 1 ? "" : "s")</p>
                </div>
                <div class="text-end">
                    @if (quizResults.TryGetValue(quiz.Id, out var result))
                    {
                        <div class="mb-2"><span class="status-pill approved">Scored @result.Score/@result.TotalQuestions</span></div>
                        <a asp-action="TakeQuiz" asp-route-quizId="@quiz.Id" class="btn btn-sm btn-outline-primary">Retake Quiz</a>
                    }
                    else
                    {
                        <a asp-action="TakeQuiz" asp-route-quizId="@quiz.Id" class="btn btn-sm btn-primary">Take Quiz</a>
                    }
                </div>
            </div>
        </div>
    }
}
