@model List<EduLearn.Models.Course>

@{
    ViewData["Title"] = "All Courses";
    string? searchTerm = ViewBag.SearchTerm;
    int? categoryId = ViewBag.CategoryId;
    string sort = ViewBag.Sort;
    var categories = (List<EduLearn.Models.Category>)ViewBag.Categories;
    bool hasActiveFilters = !string.IsNullOrWhiteSpace(searchTerm) || categoryId.HasValue;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    var ratings = (Dictionary<int, (double Average, int Count)>)ViewBag.RatingsByCourseId;
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <h2 class="section-title">Explore Courses</h2>
        <p class="text-muted-2 mb-0">Browse every published course on EduLearn.</p>
    </div>
    <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 align-items-center">
        <select name="categoryId" class="form-select" onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var cat in categories)
            {
                <option value="@cat.Id" selected="@(categoryId == cat.Id ? "selected" : null)">@cat.Name</option>
            }
        </select>
        <select name="sort" class="form-select" onchange="this.form.submit()">
            <option value="newest" selected="@(sort == "newest" ? "selected" : null)">Newest</option>
            <option value="popular" selected="@(sort == "popular" ? "selected" : null)">Most Popular</option>
            <option value="rating" selected="@(sort == "rating" ? "selected" : null)">Highest Rated</option>
        </select>
        <div class="search-bar">
            <input type="text" name="search" class="form-control" placeholder="Search courses..." value="@searchTerm" />
            <button type="submit" class="btn btn-primary">
                <svg class="icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </button>
        </div>
    </form>
</div>

@if (hasActiveFilters)
{
    <p class="text-muted-2 mb-3">
        @if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <text>Showing results for "<strong>@searchTerm</strong>"</text>
        }
        @if (categoryId.HasValue)
        {
            <text> in <strong>@categories.FirstOrDefault(c => c.Id == categoryId)?.Name</strong></text>
        }
        <a asp-action="Index" class="ms-2">Clear filters</a>
    </p>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <svg class="icon" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
        <p class="mb-0">
            @(hasActiveFilters ? "No courses match these filters." : "No courses have been published yet. Check back soon.")
        </p>
    </div>
}
else
{
    <div class="row">
        @{ int cardIndex = 0; }
        @foreach (var course in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card course-card h-100">
                    @if (!string.IsNullOrEmpty(course.ThumbnailPath))
                    {
                        <img src="@course.ThumbnailPath" class="card-img-top" alt="@course.Title" />
                    }
                    else
                    {
                        <div class="course-thumb-placeholder accent-@(cardIndex % 5)">
                            <svg class="icon" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="code-badge">@course.CourseCode</span>
                            <span class="badge text-bg-light border">@course.Category?.Name</span>
                        </div>
                        <h5 class="card-title">@course.Title</h5>
                        <p class="card-text text-muted-2 small">@course.Description</p>
                        @if (course.Instructor != null)
                        {
                            <p class="small text-muted-2 mb-1">By @course.Instructor.FullName</p>
                        }
                        @{
                            var stat = ratings.TryGetValue(course.Id, out var s) ? s : (Average: 0.0, Count: 0);
                        }
                        <div class="small text-muted-2 mb-2">
                            @if (stat.Count > 0)
                            {
                                for (var i = 1; i <= 5; i++)
                                {
                                    <span style="color:@(i <= Math.Round(stat.Average) ? "#FFC93C" : "#d8d8d8");">★</span>
                                }
                                <span>@stat.Average.ToString("0.0") (@stat.Count)</span>
                            }
                            else
                            {
                                <span>No reviews yet</span>
                            }
                        </div>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <strong>@(course.Price == 0 ? "Free" : $"TK {course.Price}")</strong>
                            <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-primary">View Course</a>
                        </div>
                    </div>
                </div>
            </div>
            cardIndex++;
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="d-flex justify-content-center gap-2 mt-3">
            <a asp-action="Index"
               asp-route-search="@searchTerm" asp-route-categoryId="@categoryId" asp-route-sort="@sort" asp-route-page="@(currentPage - 1)"
               class="btn btn-sm btn-outline-primary @(currentPage <= 1 ? "disabled" : "")">Previous</a>

            @for (var p = 1; p <= totalPages; p++)
            {
                <a asp-action="Index"
                   asp-route-search="@searchTerm" asp-route-categoryId="@categoryId" asp-route-sort="@sort" asp-route-page="@p"
                   class="btn btn-sm @(p == currentPage ? "btn-primary" : "btn-outline-primary")">@p</a>
            }

            <a asp-action="Index"
               asp-route-search="@searchTerm" asp-route-categoryId="@categoryId" asp-route-sort="@sort" asp-route-page="@(currentPage + 1)"
               class="btn btn-sm btn-outline-primary @(currentPage >= totalPages ? "disabled" : "")">Next</a>
        </nav>
    }
}
