@{
    ViewData["Title"] = "Submit Assignment";
}

<div class="mx-auto" style="max-width:520px;">
    <h2 class="section-title mb-3">Submit Assignment</h2>
    <p class="text-muted-2 mb-4">@ViewBag.AssignmentTitle</p>

    <div class="card form-card">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <form asp-action="SubmitAssignment" method="post" enctype="multipart/form-data">
            <input type="hidden" name="assignmentId" value="@ViewBag.AssignmentId" />
            <div class="mb-3">
                <label for="submissionFileInput" class="form-label">Upload your file</label>
                <input type="file" id="submissionFileInput" name="SubmissionFile" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Submit</button>
        </form>
    </div>
</div>
