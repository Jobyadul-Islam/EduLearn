@{
    ViewData["Title"] = "Verify Your Code";
    string token = ViewBag.Token;
}

<div class="auth-card">
    <div class="text-center mb-4">
        <svg class="icon" style="width:2.5rem;height:2.5rem;color:var(--color-primary);" viewBox="0 0 24 24"><path d="M22 6c0-1.1-.9-2-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h16a2 2 0 0 0 2-2V6Z"/><path d="m22 6-10 7L2 6"/></svg>
        <h2 class="section-title mt-2 mb-1">Verify your code</h2>
        <p class="text-muted-2">Enter the 6-digit code from the approval email to continue.</p>
    </div>

    <div class="card form-card">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <form asp-action="VerifyAccessCode" method="post">
            <input type="hidden" name="token" value="@token" />
            <div class="mb-4">
                <label for="codeInput" class="form-label">Verification Code</label>
                <input type="text" id="codeInput" name="code" class="form-control text-center" style="font-size:1.5rem; letter-spacing:.5rem;" maxlength="6" pattern="[0-9]{6}" placeholder="000000" autofocus />
            </div>
            <button type="submit" class="btn btn-primary w-100">Verify & Continue</button>
        </form>
    </div>
</div>
