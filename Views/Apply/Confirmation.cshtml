@{
    ViewData["Title"] = "Application Submitted";
}

<div class="empty-state mx-auto" style="max-width:480px;">
    <svg class="icon" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
    <h2 class="section-title mb-2">Application Submitted</h2>
    <p>Thanks for applying! An Admin will review your application and approve your account. You'll be able to log in once approved.</p>
    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">Go to Login</a>
</div>
