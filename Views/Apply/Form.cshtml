@model EduLearn.Models.ViewModels.InstructorApplicationViewModel

@{
    ViewData["Title"] = "Instructor Application";
}

<div class="mx-auto" style="max-width:680px;">
    <h2 class="section-title mb-1">Instructor Application</h2>
    <p class="text-muted-2 mb-4">PIN verified. Fill out the form below — an Admin will review your application before it's approved.</p>

    <div class="card form-card">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <form asp-action="Form" method="post">
            <h5 class="mb-3">Account Details</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
            </div>

            <hr class="my-4" />
            <h5 class="mb-3">Academic Background & Skills</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Highest Qualification</label>
                    <input asp-for="Qualification" class="form-control" placeholder="e.g. B.Sc. in Computer Science" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Institution</label>
                    <input asp-for="Institution" class="form-control" placeholder="e.g. University of Dhaka" />
                </div>
                <div class="col-md-8 mb-3">
                    <label class="form-label">Skills / Areas of Expertise</label>
                    <input asp-for="Skills" class="form-control" placeholder="e.g. Web Development, Python, Data Analysis" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Years of Experience</label>
                    <input asp-for="YearsOfExperience" type="number" class="form-control" min="0" max="60" />
                </div>
                <div class="col-12 mb-4">
                    <label class="form-label">Short Bio</label>
                    <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Tell us about your teaching background and why you want to teach on EduLearn."></textarea>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100">Submit Application</button>
        </form>
    </div>
</div>
