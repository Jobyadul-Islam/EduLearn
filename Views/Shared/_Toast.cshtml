@model (string Message, string Type)

<div class="toast align-items-center text-bg-@Model.Type border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="6000">
    <div class="d-flex">
        <div class="toast-body">@Model.Message</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
</div>
