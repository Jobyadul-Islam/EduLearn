@using Microsoft.AspNetCore.Identity
@using EduLearn.Models
@using EduLearn.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduLearn</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduLearn.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="brand-stripe"></div>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M22 10L12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg>
                    EduLearn
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Course" asp-action="Index">Courses</a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                var pendingCount = DbContext.Courses.Count(c => c.Status == CourseStatus.Pending);
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Admin" asp-action="Index">
                                        Admin Dashboard
                                        @if (pendingCount > 0)
                                        {
                                            <span class="badge rounded-pill text-bg-warning badge-notify">@pendingCount</span>
                                        }
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Instructor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Instructor" asp-action="Index">Instructor Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Instructor" asp-action="Reviews">My Reviews</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Instructor" asp-action="QuizResults">Quiz Results</a>
                                </li>
                            }
                            @if (User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Course" asp-action="MyEnrollments">My Courses</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Course" asp-action="OrderHistory">Order History</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUserId = UserManager.GetUserId(User);
                            var myNotifications = DbContext.Notifications
                                .Where(n => n.UserId == currentUserId)
                                .OrderByDescending(n => n.CreatedAt)
                                .Take(8)
                                .ToList();
                            var unreadCount = myNotifications.Count(n => !n.IsRead);

                            // NEW — current user's avatar for the nav chip
                            var navCurrentUser = await UserManager.GetUserAsync(User);
                            var navAvatarSrc = string.IsNullOrEmpty(navCurrentUser?.ProfilePicture)
                                ? "/image/user-circles-set_78370-4704.avif"
                                : navCurrentUser.ProfilePicture;

                            <li class="nav-item dropdown">
                                <button class="notify-bell-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                                    <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                                    @if (unreadCount > 0)
                                    {
                                        <span class="notify-bell-dot">@(unreadCount > 9 ? "9+" : unreadCount.ToString())</span>
                                    }
                                </button>
                                <div class="dropdown-menu dropdown-menu-end notify-dropdown p-0">
                                    <div class="notify-header d-flex justify-content-between align-items-center">
                                        <span>Notifications</span>
                                        @if (unreadCount > 0)
                                        {
                                            <form asp-controller="Notification" asp-action="MarkAllRead" asp-area="" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-link btn-sm p-0">Mark all read</button>
                                            </form>
                                        }
                                    </div>
                                    @if (!myNotifications.Any())
                                    {
                                        <div class="notify-empty">
                                            <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" style="width:2rem;height:2rem;"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                                            <p class="mb-0 mt-2">No notifications yet</p>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var n in myNotifications)
                                        {
                                            <form asp-controller="Notification" asp-action="MarkRead" asp-area="" method="post">
                                                <input type="hidden" name="id" value="@n.Id" />
                                                <input type="hidden" name="returnUrl" value="@(n.Link ?? "")" />
                                                <button type="submit" class="notify-item @(n.IsRead ? "" : "unread") border-0 text-start w-100 bg-transparent">
                                                    <div class="notify-message">@n.Message</div>
                                                    <div class="text-muted-2" style="font-size:.75rem;">@n.CreatedAt.ToString("g")</div>
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <a asp-area="" asp-controller="Profile" asp-action="Index" class="user-chip text-decoration-none">
                                    <img src="@navAvatarSrc" alt="Profile picture" class="user-avatar-img" />
                                    <span class="user-email">@User.Identity!.Name</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Apply" asp-action="Index">Apply as Instructor</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-lg-2" asp-area="Identity" asp-page="/Account/Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="page-main">
            @RenderBody()
        </main>
    </div>
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1080;" id="toastContainer">
        @await RenderSectionAsync("Toasts", required: false)
    </div>
    <footer class="site-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <span>&copy; 2026 EduLearn</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted-2">Privacy</a>
        </div>
    </footer>
    @if (SignInManager.IsSignedIn(User))
    {
        <button class="chat-launcher" type="button" id="chatLauncher" aria-label="Open chat assistant">
            <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </button>
        <div class="chat-panel" id="chatPanel">
            <div class="chat-panel-header">
                <span>EduLearn Assistant</span>
                <button type="button" id="chatCloseBtn" aria-label="Close chat">&times;</button>
            </div>
            <div class="chat-panel-body" id="chatBody">
                <div class="chat-msg bot">
                    @if (User.IsInRole("Student"))
                    {
                        <text>Hi! Tell me about your background, interests, and any courses you've already done (here or elsewhere), and I'll suggest what to take next on EduLearn.</text>
                    }
                    else
                    {
                        <text>Hi! I'm the EduLearn Assistant. Ask me anything about the platform.</text>
                    }
                </div>
            </div>
            <div class="chat-panel-input">
                <label for="chatInput" class="visually-hidden">Chat message</label>
                <input type="text" id="chatInput" placeholder="Type a message..." maxlength="500" aria-label="Chat message" />
                <button type="button" id="chatSendBtn" aria-label="Send message">
                    <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" style="width:1.1rem;height:1.1rem;"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                </button>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>